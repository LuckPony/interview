# ===== LLM Provider（不再支持服务器级/共享 key：这里全部留空）=====
# 云端多用户：必须全部留空 —— 后端不配任何默认 key，也不再读取 API_KEY。
# 桌面端用户 key 仅存本机（随请求头 X-LLM-Key 临时传入，不落服务器）；
# Web 端用户在「设置」页填自己的 key（服务器按用户隔离存储）。
# 未配置 key 时 AI 功能会明确提示用户去「设置」页填写。
API_KEY=
DASHSCOPE_API_KEY=
PROVIDER_KIMI_API_KEY=
# 可选，默认 deepseek-chat
MODEL_NAME=deepseek-chat

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=interview

# ===== 服务发布端口 =====
WEB_PORT=18080
BACKEND_HOST_PORT=23333
POSTGRES_HOST_PORT=5432
# 公开访问使用 0.0.0.0；生产环境务必在云平台限制 PostgreSQL 的来源 IP。
BACKEND_BIND_ADDRESS=0.0.0.0
POSTGRES_BIND_ADDRESS=0.0.0.0

# ===== Redis =====
REDIS_HOST_PORT=6379
REDIS_BIND_ADDRESS=0.0.0.0

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_BIND_ADDRESS=0.0.0.0

# ===== 对象存储 MinIO（可选，有默认值）=====
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview
APP_STORAGE_REGION=us-east-1

# ===== JWT 密钥（生产环境务必修改）=====
APP_JWT_SECRET=change-me-to-a-long-random-string

# ===== Swagger（生产默认关；本地开发想开就设 true）=====
APP_SWAGGER_ENABLED=false

# ===== 邮箱验证（可选：不配则注册自动通过）=====
# 用 QQ/163/Outlook 等 SMTP，密码填「授权码」而不是登录密码。
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=面霸 <你的发件邮箱>
