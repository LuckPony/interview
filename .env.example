# ===== LLM Provider（可选；不配则服务器不带任何 key，每个用户在「设置」页用自己的 key）=====
# 云端多用户：建议全部留空 —— 桌面端用户 key 仅存本机（随请求临时传入，不落服务器）；
# Web 端用户在「设置」页填自己的 key（服务器按用户隔离存储）。本地单机模式可继续填 API_KEY。
API_KEY=
DASHSCOPE_API_KEY=
PROVIDER_KIMI_API_KEY=
# 可选，默认 deepseek-chat
MODEL_NAME=deepseek-chat

# ===== 基础设施（与 docker-compose.dev.yml 默认值一致，可省略）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pony
POSTGRES_PASSWORD=123456
POSTGRES_DB=interview
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== 对象存储 MinIO（可选，有默认值）=====
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview
APP_STORAGE_REGION=us-east-1

# ===== JWT 密钥（生产环境务必修改）=====
APP_JWT_SECRET=change-me-to-a-long-random-string

# ===== Swagger（生产默认关；本地开发想开就设 true）=====
APP_SWAGGER_ENABLED=false

# ===== 邮箱验证（可选：不配则注册自动通过）=====
# 用 QQ/163/Outlook 等 SMTP，密码填「授权码」而不是登录密码。
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=面霸 <你的发件邮箱>
