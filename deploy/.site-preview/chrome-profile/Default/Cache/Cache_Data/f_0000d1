\r\n}\r\n\r\n/* —— 评分总结：独立于聊天线程，显示在输入框下方 —— */\r\n.chat-verdict {\r\n  padding: var(--s-5) var(--s-6);\r\n  background: var(--paper);\r\n  border: 1px solid color-mix(in oklch, var(--cinnabar) 20%, var(--line));\r\n}\r\n\r\n.chat-row-loading .chat-bubble {\r\n  padding: var(--s-3) var(--s-4);\r\n  font-size: var(--fs-sm);\r\n  color: var(--ink-soft);\r\n}\r\n.chat-row-followup-ask {\r\n  margin-top: var(--s-3);\r\n}\r\n\r\n/* —— 追问结束后过渡提示 —— */\r\n.followup-settled-note {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: var(--s-3);\r\n  padding: var(--s-3) var(--s-4);\r\n  font-size: var(--fs-sm);\r\n  color: var(--ink-soft);\r\n  background: var(--paper-3);\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r-md);\r\n  margin-bottom: var(--s-3);\r\n}\r\n.followup-settled-note button {\r\n  font-family: var(--font-mono);\r\n  font-size: var(--fs-xs);\r\n  color: var(--cinnabar);\r\n  background: transparent;\r\n  border: 1px solid color-mix(in oklch, var(--cinnabar) 35%, transparent);\r\n  border-radius: 99px;\r\n  padding: 3px 10px;\r\n  cursor: pointer;\r\n  transition: all 0.3s var(--ease-out);\r\n}\r\n.followup-settled-note button:hover {\r\n  background: var(--cinnabar-wash);\r\n}\r\n\r\n/* —— 资料上传（基于自己的书/项目资料学习） —— */\r\n.upload-card {\r\n  margin-bottom: var(--s-4);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--s-2);\r\n}\r\n.upload-hint {\r\n  color: var(--ink-soft);\r\n  font-size: var(--fs-sm);\r\n  line-height: 1.6;\r\n  margin: 0;\r\n}\r\n.upload-btn {\r\n  align-self: flex-start;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: var(--s-2);\r\n  padding: var(--s-2) var(--s-4);\r\n  border: 1px solid var(--line-strong);\r\n  border-radius: var(--r-md);\r\n  background: var(--paper);\r\n  color: var(--ink);\r\n  font-size: var(--fs-sm);\r\n  cursor: pointer;\r\n  transition: border-color 0.3s var(--ease-out), transform 0.2s var(--ease-out);\r\n}\r\n.upload-btn:hover {\r\n  border-color: var(--cinnabar);\r\n  transform: translateY(-1px);\r\n}\r\n/* —— 资料候选知识点（C1：提取展示 + 勾选并入规划） —— */\r\n.kp-panel {\r\n  margin-top: var(--s-1);\r\n  border-top: 1px dashed var(--line-strong);\r\n  padding-top: var(--s-3);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--s-2);\r\n}\r\n.kp-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));\n  gap: 9px;\n  max-height: 320px;\n  overflow-y: auto;\r\n  padding-right: var(--s-1);\r\n}\r\n.kp-item {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--s-2);\n  padding: 13px;\n  border: 1px solid var(--line);\n  border-radius: 11px;\n  background: var(--paper-2);\n  font-size: var(--fs-sm);\r\n  cursor: pointer;\r\n}\r\n.kp-item input {\n  flex-shrink: 0;\n  margin-top: 3px;\n  accent-color: var(--cinnabar);\r\n}\r\n.kp-name {\n  display:block;\n  font-weight: 500;\n  line-height:1.65;\n  overflow-wrap:anywhere;\n}\r\n.kp-snippet {\n  display:block;\n  margin-top:5px;\n  color: var(--ink-soft);\r\n  font-size: var(--fs-xs);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  line-height:1.7;\n  display:-webkit-box;\n  -webkit-line-clamp:2;\n  -webkit-box-orient:vertical;\n}\n.kp-content { flex:1; min-width:0; }\n.kp-item.is-selected { border-color:color-mix(in srgb,var(--cinnabar) 40%,var(--line)); background:var(--cinnabar-wash); }\n.kp-item:focus-within { outline:2px solid var(--cinnabar); outline-offset:2px; }\n.kp-heading { display:flex; justify-content:space-between; align-items:center; font-size:14px; color:var(--ink); }\n.kp-heading small, .kp-count { font-size:10px; color:var(--ink-faint); }\n.kp-count { white-space:nowrap; padding-top:4px; }\n.kp-merge {\r\n  margin-top: var(--s-1);\r\n}\r\n.attached-file {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: var(--s-3);\r\n  padding: var(--s-2) var(--s-3);\r\n  border: 1px solid var(--line-strong);\r\n  border-radius: var(--r-md);\r\n  background: var(--paper);\r\n}\r\n.attached-file .file-name {\r\n  font-weight: 500;\r\n  color: var(--ink);\r\n}\r\n.file-remove {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 22px;\r\n  height: 22px;\r\n  border: none;\r\n  border-radius: 50%;\r\n  background: transparent;\r\n  color: var(--ink-soft);\r\n  cursor: pointer;\r\n  transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);\r\n}\r\n.file-remove:hover {\r\n  background: var(--line);\r\n  color: var(--ink);\r\n}\r\n\r\n/* —— 方向卡片上的资料标签 —— */\r\n.plan-corpus {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: var(--s-2);\r\n  margin-bottom: var(--s-2);\r\n  padding-bottom: var(--s-2);\r\n  border-bottom: 1px dashed var(--line);\r\n}\r\n.plan-corpus .corpus-name {\r\n  color: var(--ink);\r\n  font-weight: 500;\r\n  font-size: var(--fs-sm);\r\n}\r\n\r\n/* —— 桌面端免上传：选本地文件/文件夹 —— */\r\n.path-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: var(--s-3);\r\n  margin-top: var(--s-3);\r\n}\r\n\r\n/* —— 出题加载遮罩：点「继续学习/开始练习/下一题」后，后端调 LLM 生成新题期间的提示 —— */\r\n.gen-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 60;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: color-mix(in oklch, var(--paper) 72%, transparent);\r\n  backdrop-filter: blur(2px);\r\n  -webkit-backdrop-filter: blur(2px);\r\n  animation: gen-fade 0.18s ease-out;\r\n}\r\n.gen-overlay-card {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: var(--s-3);\r\n  padding: var(--s-4) var(--s-5);\r\n  background: var(--paper-2);\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r-lg);\r\n  box-shadow: 0 12px 40px -12px rgba(35, 43, 54, 0.16);\r\n  color: var(--ink);\r\n  font-size: var(--fs-md);\r\n}\r\n.gen-overlay-card .spinner {\r\n  width: 18px;\r\n  height: 18px;\r\n  flex: 0 0 auto;\r\n}\r\n.gen-overlay-card p {\r\n  margin: 0;\r\n}\r\n@keyframes gen-fade {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n\r\n\r\n\r\n/* —— 今日任务（每日自动排期，预生成题秒开） —— */\r\n.today-card {\r\n  padding: var(--s-5) var(--s-6);\r\n  margin-bottom: var(--s-5);\r\n  border: 1px solid color-mix(in oklch, var(--cinnabar) 25%, var(--line));\r\n}\r\n.today-head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: var(--s-2);\r\n  margin-bottom: var(--s-4);\r\n  color: var(--cinnabar-deep);\r\n}\r\n.today-title {\r\n  font-weight: 600;\r\n  color: var(--ink);\r\n}\r\n.today-count {\r\n  display: flex;\r\n  gap: var(--s-2);\r\n  margin-left: auto;\r\n}\r\n.today-kind {\r\n  font-family: var(--font-mono);\r\n  font-size: var(--fs-xs);\r\n  padding: 2px 8px;\r\n  border-radius: 99px;\r\n}\r\n.today-review {\r\n  color: var(--warn);\r\n  background: var(--warn-wash);\r\n}\r\n.today-new {\r\n  color: var(--good);\r\n  background: var(--good-wash);\r\n}\r\n.today-groups {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: var(--s-4);\r\n}\r\n.today-group {\r\n  min-width: 0;\r\n  padding: var(--s-4);\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r-md);\r\n  background: var(--paper-2);\r\n}\r\n.today-group-head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: var(--s-2);\r\n  margin-bottom: var(--s-3);\r\n  color: var(--ink);\r\n}\r\n.today-group-head span {\r\n  margin-left: auto;\r\n  color: var(--ink-faint);\r\n  font-size: var(--fs-xs);\r\n}\r\n.today-task-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));\r\n  gap: var(--s-3);\r\n}\r\n.today-task-card {\r\n  display: flex;\r\n  min-width: 0;\r\n  flex-direction: column;\r\n  align-items: stretch;\r\n  gap: var(--s-2);\r\n  padding: var(--s-4);\r\n  text-align: left;\r\n  font: inherit;\r\n  color: var(--ink);\r\n  background: var(--paper);\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r-md);\r\n  cursor: pointer;\r\n  transition: transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);\r\n}\r\n.today-task-card:hover {\r\n  transform: translateY(-2px);\r\n  border-color: var(--cinnabar);\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n.today-task-card.is-review { border-top: 3px solid var(--warn); }\r\n.today-task-card.is-learn { border-top: 3px solid var(--good); }\r\n.today-task-top {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: var(--s-2);\r\n}\r\n.today-task-plan {\r\n  min-width: 0;\r\n  flex: 1;\r\n  overflow: hidden;\r\n  color: var(--ink-faint);\r\n  font-size: var(--fs-xs);\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.today-task-concept {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: var(--s-2);\r\n  font-size: var(--fs-md);\r\n}\r\n.today-task-concept em {\r\n  font: normal var(--fs-xs) var(--font-mono);\r\n  color: var(--ink-faint);\r\n}\r\n.today-task-target {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 6px;\r\n  color: var(--ink-soft);\r\n  font-size: var(--fs-sm);\r\n  line-height: 1.5;\r\n}\r\n.today-task-target svg { flex: 0 0 auto; margin-top: 3px; }\r\n.today-subpoints {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n.today-subpoints > span {\r\n  max-width: 100%;\r\n  padding: 3px 8px;\r\n  border-radius: 999px;\r\n  background: var(--paper-3);\r\n  color: var(--ink-soft);\r\n  font-size: var(--fs-xs);\r\n  overflow-wrap: anywhere;\r\n}\r\n.today-subpoints > span.is-passed {\r\n  color: var(--good);\r\n  background: var(--good-wash);\r\n}\r\n.today-task-hint {\r\n  padding-top: var(--s-2);\r\n  border-top: 1px dashed var(--line);\r\n  color: var(--ink-faint);\r\n  font-size: var(--fs-xs);\r\n  line-height: 1.5;\r\n}\r\n.today-completed-note {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  margin: var(--s-3) 0 0;\r\n  color: var(--good);\r\n  font-size: var(--fs-sm);\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .today-groups { grid-template-columns: 1fr; }\r\n}\r\n\r\n/* —— 聊天页（LEARN）：整页随内容自然滚动；标题不固定、聊天线程不内部滚动，\r\n      上下滚动即可看到完整聊天内容（.main 负责滚动） —— */\r\n.chat-page {\r\n  max-width: none;\r\n  padding: var(--s-3) var(--s-5) var(--s-4);\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: auto;\r\n  max-height: none;\r\n  overflow: visible;\r\n}\r\n.chat-page .chat-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: var(--s-3);\r\n  margin-bottom: var(--s-3);\r\n  flex-shrink: 0;\r\n}\r\n.chat-head-title h1 {\r\n  font-size: var(--fs-lg);\r\n  margin: 0;\r\n}\r\n.chat-page .banner {\r\n  flex-shrink: 0;\r\n  margin-bottom: var(--s-3);\r\n}\r\n.chat-page .chat-panel {\r\n  /* 聊天区不再锁死固定高度：随内容自然撑开，由页面统一滚动 */\r\n  flex: none;\r\n  max-width: none;\r\n  margin: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--s-3);\r\n}\r\n.chat-page .chat-thread {\r\n  flex: none;\r\n  min-height: 0;\r\n  max-height: none;\r\n  overflow: visible;\r\n}\r\n.chat-page .chat-input {\r\n  flex-shrink: 0;\r\n}\r\n.chat-page .chat-input-textarea {\r\n  /* 回复框默认 5 行起步，允许手动上下拉伸；整页滚动后不再担心撑破布局 */\r\n  resize: vertical;\r\n  max-height: 40vh;\r\n}\r\n.chat-page .chat-verdict {\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* —— 聊天页紧凑化：字体略小、输入框更矮，聊天区更高、放下更多内容 —— */\r\n.chat-page .chat-thread {\r\n  padding: var(--s-3) var(--s-4);\r\n}\r\n.chat-page .chat-bubble,\r\n.chat-page .chat-bubble .md,\r\n.chat-page .tutor-text,\r\n.chat-page .me-text {\r\n  font-size: calc(0.875rem * var(--scale-body, 1));\r\n  line-height: 1.6;\r\n}\r\n/* 用户消息里的图片（截图） */\r\n.chat-img-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: var(--s-2);\r\n  margin-bottom: var(--s-2);\r\n}\r\n.chat-img-row img {\r\n  max-width: min(320px, 100%);\r\n  max-height: 260px;\r\n  border-radius: var(--r-md);\r\n  border: 1px solid var(--line-strong);\r\n  object-fit: contain;\r\n  background: var(--paper);\r\n}\r\n.chat-page .chat-bubble.is-stem p {\r\n  font-size: calc(var(--fs-base) * var(--scale-stem, 1));\r\n}\r\n.chat-page .chat-input {\r\n  padding: var(--s-2) var(--s-4);\r\n}\r\n.chat-page .chat-input-textarea {\r\n  padding: var(--s-2) var(--s-3);\r\n  font-size: 0.875rem;\r\n  line-height: 1.5;\r\n}\r\n.chat-page .chat-input-foot {\r\n  margin-top: var(--s-2);\r\n}\r\n\r\n/* —— 应用内弹窗（Electron 不支持 window.confirm/prompt）—— */\r\n.app-modal-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 60;\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: center;\r\n  padding: clamp(16px, 6vh, 64px) 16px;\r\n  background: color-mix(in oklch, var(--ink) 28%, transparent);\r\n  animation: app-fade 0.18s var(--ease-out) both;\r\n}\r\n@keyframes app-fade {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n.app-modal {\r\n  width: min(420px, 100%);\r\n  background: var(--paper);\r\n  border: 1px solid var(--line-strong);\r\n  border-radius: var(--r-lg);\r\n  padding: var(--s-5);\r\n  animation: app-rise 0.2s var(--ease-out) both;\r\n  box-shadow: 0 24px 60px -24px rgba(35, 43, 54, 0.45);\r\n}\r\n@keyframes app-rise {\r\n  from { opacity: 0; transform: translateY(10px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n.app-modal-title {\r\n  margin: 0 0 var(--s-2);\r\n  font-size: 1.05rem;\r\n}\r\n.app-modal-message {\r\n  margin: 0 0 var(--s-4);\r\n  color: var(--ink-2);\r\n  line-height: 1.6;\r\n  white-space: pre-wrap;\r\n}\r\n.app-modal-input {\r\n  width: 100%;\r\n  margin-bottom: var(--s-4);\r\n  border: 1px solid var(--line-strong);\r\n  border-radius: var(--r-md);\r\n  background: var(--paper);\r\n  padding: var(--s-2) var(--s-3);\r\n  font-size: var(--fs-base);\r\n  color: var(--ink);\r\n}\r\n.app-modal-input:focus {\r\n  outline: none;\r\n  border-color: var(--cinnabar);\r\n}\r\n.app-modal-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: var(--s-2);\r\n}\r\n\r\n.chat-paused-note {\r\n  margin-top: var(--s-2);\r\n  font-size: 0.75rem;\r\n  color: var(--ink-faint);\r\n  font-style: italic;\r\n}\r\n\r\n/* —— 答案揭示分隔线：从此处开始是参考答案，此后的回答不再计入评分 —— */\r\n.chat-reveal-divider {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: var(--s-2);\r\n  margin-bottom: var(--s-3);\r\n  padding-bottom: var(--s-2);\r\n  border-bottom: 1px dashed var(--line-strong);\r\n  color: var(--cinnabar);\r\n  font-size: 0.75rem;\r\n  font-weight: 600;\r\n  letter-spacing: 0.02em;\r\n}\r\n.chat-reveal-divider::before,\r\n.chat-reveal-divider::after {\r\n  content: '';\r\n  flex: 1;\r\n  height: 1px;\r\n  background: var(--line-strong);\r\n}\r\n\r\n.today-empty {\r\n  margin: 0;\r\n  font-size: var(--fs-sm);\r\n  color: var(--ink-faint);\r\n  font-style: italic;\r\n}\r\n\r\n/* ===== 先教后考（teach 视图：子知识点清单 + 逐个讲解）===== */\r\n/* teach 页面整体随内容滚动：标题栏不固定，阅读空间更大（.main 负责滚动） */\r\n.chat-page.teach-page {\r\n  height: auto;\r\n  max-height: none;\r\n  overflow: visible;\r\n}\r\n.chat-page.teach-page .teach-panel {\r\n  flex: none;\r\n  overflow: visible;\r\n}\r\n.teach-panel {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  /* 与外侧容器同宽（不再限 760px，教学/讲解内容更宽更好读） */\r\n  max-width: none;\r\n  margin: 0;\r\n  /* 讲解文字可能很长：在固定高度的聊天页内独立滚动，避免被 .chat-page 的 overflow:hidden 裁掉 */\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n}\r\n.teach-head-topic {\r\n  margin: 2px 0 0;\r\n  font-size: var(--fs-sm);\r\n  color: var(--ink-faint);\r\n}\r\n.teach-toggle {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: var(--fs-sm);\r\n  color: var(--ink-soft);\r\n  cursor: pointer;\r\n  user-select: none;\r\n}\r\n.teach-toggle input {\r\n  accent-color: var(--cinnabar);\r\n  width: 15px;\r\n  height: 15px;\r\n  cursor: pointer;\r\n}\r\n.teach-card {\r\n  padding: 20px 22px;\r\n}\r\n.teach-title {\r\n  margin: 0 0 8px;\r\n  font-size: 1.125rem;\r\n  font-weight: 650;\r\n  color: var(--ink);\r\n}\r\n.teach-hint {\r\n  margin: 0 0 16px;\r\n  font-size: var(--fs-sm);\r\n  color: var(--ink-faint);\r\n}\r\n.teach-outline {\r\n  list-style: none;\r\n  margin: 0 0 16px;\r\n  padding: 0;\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 