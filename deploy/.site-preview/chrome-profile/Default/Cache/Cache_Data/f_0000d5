const __vite__css = "/* ============================================================\r\n   对话沉淀（CAPTURE）：随手问答 → 一键存卡\r\n   风格对齐 ConversationStream 气泡 + 设计令牌（tokens.css）\r\n   ============================================================ */\r\n\r\n/* —— 页面整体入场 —— */\r\n.page.capture .page-head,\r\n.page.capture .capture-composer,\r\n.page.capture .capture-cards {\r\n  animation: capture-rise 0.5s var(--ease-out) both;\r\n}\r\n.page.capture .capture-chat { animation-delay: 0.05s; }\r\n.page.capture .capture-composer { animation-delay: 0.1s; }\r\n.page.capture .capture-cards { animation-delay: 0.15s; }\r\n@keyframes capture-rise {\r\n  from { opacity: 0; transform: translateY(12px); }\r\n  to   { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n/* —— 自动成卡开关 —— */\r\n.capture-auto {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: var(--s-2);\r\n  margin-top: var(--s-4);\r\n  font-size: var(--fs-sm);\r\n  color: var(--ink-soft);\r\n  cursor: pointer;\r\n  user-select: none;\r\n  transition: color 0.2s var(--ease-out);\r\n}\r\n.capture-auto:hover {\r\n  color: var(--cinnabar-deep);\r\n}\r\n.capture-auto input {\r\n  accent-color: var(--cinnabar);\r\n  width: 15px;\r\n  height: 15px;\r\n  transition: transform 0.2s var(--ease-out);\r\n}\r\n.capture-auto:hover input {\r\n  transform: scale(1.15);\r\n}\r\n\r\n/* —— 对话区（气泡容器） —— */\r\n.capture-chat {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--s-3);\r\n  padding: var(--s-5);\r\n  min-height: 240px;\r\n  max-height: 46vh;\r\n  overflow-y: auto;\r\n  margin-bottom: var(--s-4);\r\n}\r\n\r\n/* —— 空状态：没输入时的引导 —— */\r\n.capture-empty {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: var(--s-4);\r\n  padding: var(--s-7) var(--s-4);\r\n  text-align: center;\r\n  color: var(--ink-soft);\r\n}\r\n.capture-empty-icon {\r\n  color: var(--cinnabar);\r\n  opacity: 0.55;\r\n  animation: capture-breathe 2.6s ease-in-out infin