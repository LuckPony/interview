dle; margin-right: 6px; }\n.capture-message-file small { margin-left: 8px; opacity: .75; }\n.capture-message-file pre { overflow: auto; max-height: 240px; margin-top: 10px; font: 12px/1.6 var(--font-mono); white-space: pre; }\n.capture-drop-overlay {\n  position: fixed; inset: 20px; z-index: 200; display: flex; flex-direction: column; align-items: center;\n  justify-content: center; gap: 15px; padding: 20px; border: 2px dashed var(--cinnabar); border-radius: 22px;\n  background: color-mix(in srgb, var(--paper-2) 93%, transparent); color: var(--cinnabar-deep);\n  pointer-events: none; text-align: center;\n}\n.capture-composer-textarea {\r\n  width: 100%;\r\n  border: 1px solid var(--line-strong);\r\n  border-radius: var(--r-md);\r\n  background: var(--paper);\r\n  padding: var(--s-3) var(--s-4);\r\n  font-family: var(--font-sans);\r\n  font-size: var(--fs-base);\r\n  line-height: 1.65;\r\n  color: var(--ink);\r\n  resize: vertical;\r\n  max-height: 24vh;\r\n  transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);\r\n}\r\n.capture-composer-textarea:focus {\r\n  outline: none;\r\n  border-color: var(--cinnabar);\r\n  box-shadow: 0 0 0 3px var(--cinnabar-wash);\r\n}\r\n.capture-composer-textarea::placeholder {\r\n  color: var(--ink-faint);\r\n}\r\n.capture-composer-textarea:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n.capture-composer-foot {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: var(--s-3);\r\n  margin-top: var(--s-3);\r\n  flex-wrap: wrap;\r\n}\r\n.capture-composer-hint {\r\n  font-size: var(--fs-xs);\r\n  color: var(--ink-soft);\r\n  line-height: 1.55;\r\n}\r\n.capture-composer-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: var(--s-3);\r\n  flex-wrap: wrap;\r\n}\r\n.capture-composer-actions .btn {\r\n  transition: transform 0.15s var(--ease-out), box-shadow 0.2s var(--ease-out), background 0.2s var(--ease-out);\r\n}\r\n.capture-composer-actions .btn:hover:not(:disabled) {\r\n  transform: translateY(-1px);\r\n}\r\n.capture-composer-actions .btn:active:not(:disabled) {\r\n  transform: translateY(0) scale(0.97);\r\n}\r\n\r\n/* —— 已沉淀的卡片列表 —— */\r\n.capture-cards {\r\n  margin-top: var(--s-7);\r\n}\r\n.capture-cards h2 {\r\n  font-size: var(--fs-lg);\r\n  margin-bottom: var(--s-4);\r\n}\r\n\r\n.card-item {\r\n  position: relative;\r\n  margin-bottom: var(--s-3);\r\n  padding-right: 172px; /* 给 查看答案/编辑/删除 按钮留位，避免压住内容 */\r\n  transition: transform 0.2s var(--ease-out), box-shadow 0.25s var(--ease-out), border-color 0.2s var(--ease-out);\r\n}\r\n.card-item:hover {\r\n  transform: translateY(-2px);\r\n  border-color: var(--line-strong);\r\n  box-shadow: 0 12px 28px -14px rgba(35, 43, 54, 0.25);\r\n}\r\n.card-q {\r\n  font-weight: 600;\r\n  color: var(--ink);\r\n  line-height: 1.5;\r\n}\r\n.card-a {\r\n  margin-top: var(--s-2);\r\n  color: var(--ink-soft);\r\n  font-size: var(--fs-sm);\r\n  line-height: 1.6;\r\n  white-space: pre-wrap;\r\n}\r\n/* —— 标签（Badge）美化：默认最多两行；第二行还要换行时右下角显示带箭头的「展开」 —— */\r\n.card-tags-wrap {\r\n  position: relative;\r\n  margin-top: var(--s-3);\r\n}\r\n.card-tags {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: var(--s-2);\r\n  overflow: hidden;\r\n  transition: max-height 0.28s var(--ease-out);\r\n  /* max-height 由 CardTags 组件按首个标签实际高度动态设置（两行） */\r\n}\r\n.card-tags.expanded {\r\n  max-height: none !important;\r\n}\r\n/* 溢出时给右下角「展开」按钮留位 */\r\n.card-tags-wrap.has-toggle .card-tags {\r\n  padding-right: 64px;\r\n}\r\n.card-tags-toggle {\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 3px;\r\n  font-family: var(--font-sans);\r\n  font-size: var(--fs-xs);\r\n  color: var(--cinnabar-deep);\r\n  background: var(--paper-2);\r\n  border: 1px solid color-mix(in oklch, var(--cinnabar) 40%, transparent);\r\n  border-radius: 99px;\r\n  padding: 2px 8px;\r\n  cursor: pointer;\r\n  box-shadow: 0 0 0 3px var(--paper-2); /* 与卡片同色描边，盖住标签时