{
  "name": "interview-desktop",
  "version": "0.3.5",
  "private": true,
  "description": "面霸 · 备考助手的桌面壳：本地模式拉起 Spring Boot 后端，云端模式直连服务器；加载 React SPA + 本地 fs 桥（免上传读大项目）",
  "main": "src/main.js",
  "scripts": {
    "sync-spa": "VITE_API_BASE=http://127.0.0.1:8080 npm --prefix ../frontend run build && rm -rf app-dist && cp -r ../frontend/dist app-dist && rm -f config.json",
    "sync-spa:cloud": "node scripts/build-cloud.js",
    "start": "electron .",
    "start:cloud": "node scripts/build-cloud.js && electron .",
    "pack": "npm run sync-spa && electron-builder --dir",
    "dist": "npm run sync-spa && electron-builder",
    "dist:cloud": "node scripts/build-cloud.js && electron-builder",
    "dist:win": "node scripts/build-cloud.js && electron-builder --win",
    "dist:win:local": "bash scripts/build-win.sh",
    "fix:electron": "codesign --force --deep --sign - node_modules/electron/dist/Electron.app",
    "postinstall": "codesign --force --deep --sign - node_modules/electron/dist/Electron.app || true"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
