{
  "name": "interview-desktop",
  "version": "0.4.2",
  "private": true,
  "description": "面霸 · 备考助手的桌面壳：本地模式拉起 Spring Boot 后端，云端模式直连服务器；加载 React SPA + 本地 fs 桥（免上传读大项目）",
  "main": "src/main.js",
  "scripts": {
    "sync-spa": "node scripts/build-local.js",
    "sync-spa:cloud": "node scripts/build-cloud.js",
    "start": "electron .",
    "start:cloud": "node scripts/build-cloud.js && electron .",
    "pack": "npm run sync-spa && electron-builder --dir",
    "dist": "npm run sync-spa && electron-builder",
    "dist:cloud": "node scripts/build-cloud.js && electron-builder --config electron-builder.cloud.yml",
    "dist:cloud:win": "node scripts/build-cloud.js && electron-builder --win --config electron-builder.cloud.yml",
    "dist:win": "node scripts/build-cloud.js && electron-builder --win --config electron-builder.cloud.yml",
    "dist:win:local": "bash scripts/build-win.sh",
    "release": "bash scripts/release.sh",
    "release:cloud": "node scripts/build-cloud.js && electron-builder --config electron-builder.cloud.yml --publish always",
    "release:win:local": "PUBLISH=always bash scripts/build-win.sh",
    "release:local": "bash scripts/release-local.sh",
    "fix:electron": "codesign --force --deep --sign - node_modules/electron/dist/Electron.app",
    "postinstall": "node -e \"if (process.platform !== 'darwin') process.exit(0)\" && codesign --force --deep --sign - node_modules/electron/dist/Electron.app || true"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
